{
  "name": "@notification.dev/expo",
  "version": "0.3.0",
  "description": "Expo bridge for the native notification.dev SDKs",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "build",
    "src",
    "android/build.gradle",
    "android/src",
    "ios/*.swift",
    "ios/*.podspec",
    "plugin",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "expo": ">=57 <59",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "expo": "58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~5.9.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheBoldApps/notification.dev-SDKs.git",
    "directory": "expo"
  }
}
